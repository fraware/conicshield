{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research/solver-assurance-and-gradients/schemas/assurance_bundle.schema.json",
  "title": "Track2AssuranceBundle",
  "type": "object",
  "required": [
    "schema_id",
    "corrected_action",
    "specification_digest",
    "structural_fingerprint",
    "topology_digest",
    "problem_digest",
    "forward_solution_digest",
    "evidence_bundle_digest",
    "verification",
    "verification_status",
    "canonical_status",
    "release_decision",
    "primal_evidence",
    "active_set_evidence",
    "solver_provenance",
    "platform_provenance",
    "fallback_history",
    "assumptions",
    "limitations",
    "evidence_level"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "description": "Current: research.assurance_bundle.v1. Deprecated: v0 / v0_legacy (archival/invalidated)."
    },
    "corrected_action": {
      "type": "array",
      "items": { "type": "number" }
    },
    "corrected_action_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Full SHA-256 hex digest of corrected_action float64 bytes"
    },
    "specification_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "structural_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "topology_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Topology only — must never include active-set membership"
    },
    "problem_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "forward_solution_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "evidence_bundle_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED_FEASIBLE", "VERIFIED_INFEASIBLE", "UNVERIFIED"]
    },
    "verification": { "type": "object" },
    "canonical_status": { "type": "string" },
    "release_decision": { "type": "string" },
    "primal_evidence": { "type": "object" },
    "dual_evidence": { "type": ["object", "null"] },
    "active_set_evidence": { "type": "object" },
    "sensitivity_evidence": { "type": ["object", "null"] },
    "shadow_evidence": { "type": ["object", "null"] },
    "solver_provenance": { "type": "object" },
    "platform_provenance": { "type": "object" },
    "fallback_history": { "type": "array" },
    "assumptions": { "type": "array" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "L0_RECORDED",
        "L1_FEASIBILITY_VERIFIED",
        "L2_SHADOW_COMPARED",
        "L3_SENSITIVITY_VALIDATED",
        "L4_REPLAYED_AND_GOVERNED"
      ]
    },
    "promotion_eligible": { "type": "boolean" },
    "invalidation_reason": { "type": ["string", "null"] },
    "deprecated_source_schema": { "type": ["string", "null"] },
    "naming_note": { "type": "string" },
    "extras": { "type": "object" }
  },
  "additionalProperties": true
}
