{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.sampling_study.v1",
  "title": "Risk-based shadow sampling study (R10)",
  "type": "object",
  "required": [
    "schema_id",
    "corpus_version",
    "primary_backend",
    "shadow_backend",
    "results",
    "promotion_gate",
    "production_recommendation_blocked"
  ],
  "properties": {
    "schema_id": { "const": "research.sampling_study.v1" },
    "corpus_version": { "type": "string" },
    "primary_backend": { "type": "string" },
    "shadow_backend": { "type": "string" },
    "baseline_policy": { "type": "string" },
    "baseline_budget_fraction": { "type": "number" },
    "consequential_l2_threshold": { "type": "number" },
    "master_seeds": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policy",
          "budget_fraction",
          "shadowed_count",
          "scenario_count",
          "shadow_cost_relative",
          "detection_estimable",
          "false_skip_rate"
        ],
        "properties": {
          "policy": { "type": "string" },
          "budget_fraction": { "type": "number" },
          "shadowed_count": { "type": "integer" },
          "scenario_count": { "type": "integer" },
          "shadow_cost_relative": { "type": "number" },
          "consequential_detected": { "type": "integer" },
          "consequential_baseline": { "type": "integer" },
          "detection_rate": { "type": ["number", "null"] },
          "detection_estimable": { "type": "boolean" },
          "false_skip_rate": { "type": ["number", "null"] },
          "mean_l2_when_shadowed": { "type": "number" },
          "status_disagreement_count": { "type": "integer" },
          "notes": { "type": "string" },
          "seed_detection_rates": {
            "type": "array",
            "items": { "type": ["number", "null"] }
          },
          "family_stratified_detection": { "type": "object" },
          "missed_baseline_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "family_summaries_baseline": { "type": "array" },
    "negative_results": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cost_detection_curve": { "type": "array" },
    "statistical_summary": { "type": "object" },
    "production_recommendation_blocked": { "const": true },
    "production_recommendation": { "type": "null" },
    "promotion_gate": { "type": "string" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
