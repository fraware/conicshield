{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research/solver-assurance-and-gradients/schemas/cbf_held_out_corpus.schema.json",
  "title": "Track2CBFHeldOutCorpusManifest",
  "type": "object",
  "required": [
    "schema_id",
    "corpus_version",
    "corpus_family_id",
    "generation_commit",
    "case_count",
    "regimes"
  ],
  "properties": {
    "schema_id": { "type": "string" },
    "corpus_version": { "type": "string" },
    "corpus_family_id": { "type": "string" },
    "generation_commit": { "type": "string" },
    "case_count": { "type": "integer", "minimum": 1 },
    "regimes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "min_held_out_nominal": { "type": "integer" }
  },
  "additionalProperties": true
}
